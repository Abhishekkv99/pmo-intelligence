# Copy to backend/.env for local runs (`uv run ...`, `make migrate`, `make test-backend`).
# The settings module reads .env from the working directory, which is backend/.
# Every variable below is read by backend/app/config.py; the values shown are the
# local development defaults or placeholders. Never commit a filled-in copy.

# ========================
# Application
# ========================
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
PROJECT_NAME=pmo-intelligence
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ========================
# Database
# ========================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pmo_intelligence

# ========================
# Transcription (AssemblyAI)
# ========================
ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# ========================
# Azure OpenAI (signal extraction, summaries, embeddings)
# ========================
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
# Seconds before a chat or embedding request is abandoned. Without a timeout a
# dead connection waits forever.
AZURE_OPENAI_TIMEOUT_SECONDS=300

# ========================
# AWS / Storage
# ========================
AWS_REGION=eu-west-2
S3_BUCKET_NAME=pmo-intelligence-media
# For local S3-compatible storage (e.g. MinIO), set the endpoint:
S3_ENDPOINT_URL=
# "s3" for AWS or MinIO, "local" for the filesystem:
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
# Max upload size in MB for a session recording
MAX_UPLOAD_SIZE_MB=500
# Allowed upload extensions (JSON list). Defaults to the list in config.py:
# ALLOWED_EXTENSIONS=[".mp4",".mov",".webm",".mp3",".wav",".m4a",".ogg"]

# ========================
# Processing queue
# ========================
# How many pipeline jobs run at once. 1 keeps the backend's memory bounded to
# one pipeline.
PROCESSING_CONCURRENCY=1
# Start tracemalloc at boot and log allocation growth after every job. Costly;
# leave off unless investigating memory.
MEMORY_DIAGNOSTICS_ENABLED=false

# ========================
# Security
# ========================
SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Token expiration
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Cookie settings (true in staging and production with HTTPS, false for local dev)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ========================
# Sign-in
# ========================
# Email/password sign-in. Microsoft Entra ID is the only sign-in method in
# staging and production, so this is false there. It stays true for local
# development and CI, where the end-to-end suite needs a non-interactive way in.
# When false, POST /auth/register and POST /auth/login answer 403.
LOCAL_AUTH_ENABLED=true

# Microsoft Entra ID (SSO). Leave empty to disable SSO.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Other Entra tenants allowed to sign in (comma-separated tenant IDs); the home
# tenant is always allowed. Empty = single-tenant. Non-empty needs the app
# registration set to "any organizational directory".
AZURE_ALLOWED_TENANT_IDS=
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback/microsoft

# The first PMO managers: comma-separated emails, matched case-insensitively and
# given the pmo_manager role at startup and when their user row is created.
# Elevate-only: removing an email never demotes anyone. Leave empty for none.
BOOTSTRAP_ADMIN_EMAILS=
